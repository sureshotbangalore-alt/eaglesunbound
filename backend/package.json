{
  "name": "eagles-unbound-api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts --api-only --dev",
    "build": "tsc",
    "start": "node dist/server.js --api-only",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests-node/*.test.ts",
    "db:check": "tsx src/check-schema.ts",
    "db:migrate": "tsx src/check-schema.ts",
    "db:seed": "tsx src/seed.ts",
    "db:create-user": "tsx src/create-user.ts",
    "db:ping": "tsx src/db-ping.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "argon2": "0.45.2",
    "dotenv": "17.2.3",
    "express": "5.3.0",
    "multer": "2.5.0",
    "mysql2": "3.24.6",
    "next": "16.4.3",
    "validator": "13.15.35"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "2.0.0",
    "@types/node": "22.20.5",
    "@types/validator": "13.15.10",
    "typescript": "5.9.3"
  }
}
