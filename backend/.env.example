# Names only. Hostinger injects these as environment variables; locally copy to backend/.env (git-ignored).
NODE_ENV=production
PORT=
# Public site origin (https in production). Also used for CORS and cookie scope.
FRONTEND_URL=https://your-domain.example
COOKIE_SECURE=true
# Comma-separated trusted proxy IPs/CIDRs (never "true"). Leave blank if unsure.
TRUST_PROXY=
SESSION_HOURS=8

# Existing MySQL database
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=true
DB_SSL_CA=

# Required to enrol administrator MFA: 32 random bytes, base64url (same format as the previous Fernet key).
MFA_ENCRYPTION_KEY=

# Optional S3-compatible storage for media uploads
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_URL=
