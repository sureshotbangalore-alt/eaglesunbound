DATABASE_URL=postgresql+psycopg://eagles:change-me@localhost:5432/eagles
ENVIRONMENT=development
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
ADMIN_EMAIL=admin@example.com
# Set a unique password containing at least 14 characters before seeding.
ADMIN_PASSWORD=
SESSION_HOURS=8
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_EMAIL=

# Alternative: MySQL 8.0.13+ / compatible MariaDB. Leave DATABASE_URL blank to use DB_*.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=true
DB_SSL_CA=

# Required to enrol administrator MFA; generate with Fernet.generate_key().
# Back up separately from the database. Do not rotate without re-encryption.
MFA_ENCRYPTION_KEY=
