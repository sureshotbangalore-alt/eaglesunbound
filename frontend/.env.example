# Frontend settings (names only; never put secrets in NEXT_PUBLIC_* variables).
# Public address of the site. Needed at BUILD time for canonical URLs, sitemap and structured data.
# If it is not set, the first CORS_ORIGINS entry is used.
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Where the browser calls the API. /api = same site (the default, recommended).
NEXT_PUBLIC_API_URL=/api
# Where server-side rendering calls the API. /api is resolved to this same process by npm start.
API_INTERNAL_URL=/api
# Enable only on the approved production domain after content approval.
SEARCH_INDEXING_ENABLED=false
# Optional ownership verification. These do not install analytics or cookies.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
