# Environment variable NAMES for Hostinger (Node.js app, repository root). Set the real values in the Hostinger
# panel (Environment variables). Never commit a file with real values. Placeholders only below.

# --- Server (Hostinger provides PORT automatically) ---------------------------------------------------------------
PORT=
# Public https address(es) of the site, comma separated. Used for CORS, CSRF checks and (at build time) canonical URLs.
# Add a future custom domain here; no code change is needed.
CORS_ORIGINS=https://www.example.com
# Number of reverse proxies in front of the app. Hostinger: 1. Never "true".
TRUST_PROXY=1
# Secure cookies are on by default in production; only set this to override outside production.
COOKIE_SECURE=
SESSION_HOURS=8

# --- Database (existing Hostinger MySQL) ----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASSWORD=your-database-password
# TLS is off by default for a same-server database (127.0.0.1) and on for remote databases.
DB_SSL=
DB_SSL_CA=
# WRITES ARE OFF BY DEFAULT. false = read-only site (public pages work; bookings, enquiries, sign-in and CMS saving are refused).
# Set true only when you are ready for the site to save data.
ALLOW_DB_WRITES=false

# --- Frontend / API routing ------------------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=/api
API_INTERNAL_URL=/api
# Optional: public site address if it should differ from the first CORS_ORIGINS entry. Needed at build time.
NEXT_PUBLIC_SITE_URL=
# Enable only on the approved production domain after content approval.
SEARCH_INDEXING_ENABLED=false

# --- Optional ----------------------------------------------------------------------------------------------------------
# Administrator MFA (32 random bytes, base64url). Back it up separately from the database.
MFA_ENCRYPTION_KEY=
# Media uploads to S3-compatible storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_URL=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- Local development only -------------------------------------------------------------------------------------------
# EU_ENV_FILE=backend/.env.staging   load this one file instead of .env and backend/.env
